{
  "name": "@fullstax/ng-openapi-gen",
  "version": "0.8.3",
  "license": "MIT",
  "description": "An OpenAPI 3 codegen for Angular 6+",
  "author": "Cyclos development team",
  "contributors": [
    "fullstax GmbH & CO. KG (https://www.fullstax.de)"
  ],
  "keywords": [
    "angular",
    "openapi",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fllstx/ng-openapi-gen.git"
  },
  "bin": {
    "ng-openapi-gen": "bin/ng-openapi-gen.js"
  },
  "main": "lib/ng-openapi-gen.js",
  "files": [
    "bin",
    "lib",
    "templates",
    "ng-openapi-gen-schema.json"
  ],
  "scripts": {
    "test": "jasmine-ts tsconfig.json --config=jasmine.json",
    "tslint": "tslint -c tslint.json -p tsconfig.json",
    "compile": "tsc --project tsconfig.json",
    "build": "npm run tslint && npm run compile && npm test",
    "prepublishOnly": "npm run build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run build"
    }
  },
  "dependencies": {
    "argparse": "^1.0.10",
    "fs-extra": "^10.1.0",
    "handlebars": "^4.7.7",
    "jsesc": "^3.0.2",
    "json-schema": "^0.4.0",
    "json-schema-ref-parser": "^9.0.9",
    "lodash": "^4.17.21",
    "mkdirp": "^1.0.4"
  },
  "peerDependencies": {
    "@angular/core": ">=12",
    "rxjs": ">=6"
  },
  "devDependencies": {
    "@loopback/openapi-v3-types": "^1.2.1",
    "@types/argparse": "^1.0.10",
    "@types/fs-extra": "^9.0.13",
    "@types/jasmine": "^4.0.3",
    "@types/jsesc": "^3.0.1",
    "@types/json-schema": "^7.0.11",
    "@types/lodash": "^4.14.182",
    "@types/mkdirp": "^1.0.2",
    "@types/node": "^18.0.3",
    "esm": "^3.2.25",
    "husky": "^8.0.1",
    "jasmine": "^4.2.1",
    "jasmine-spec-reporter": "^7.0.0",
    "jasmine-ts": "^0.4.0",
    "mem": "^9.0.2",
    "ncp": "^2.0.0",
    "replace-in-file": "^6.3.5",
    "rimraf": "^3.0.2",
    "ts-node": "^10.8.2",
    "tslint": "^5.20.1",
    "typescript": "^4.7.4",
    "typescript-parser": "^2.6.1"
  }
}
